# Copy to .env for local development. On Vercel, add these in Project Settings → Environment Variables.
# Everything here is PUBLIC (bundled into the browser). Never put private keys here.

# Backend API, including /v1
VITE_BASE_URL=http://localhost:3000/v1

# WalletConnect project ID (https://cloud.reown.com), needed for mobile wallets
VITE_WALLETCONNECT_PROJECT_ID=

# Arc Testnet (chain 5042002), contract addresses from the contract developer
VITE_ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
VITE_OTC_CONTRACT_ARC_TESTNET=
VITE_PREMARKET_CONTRACT_ARC_TESTNET=

# Arkiv order book. Lock the key to your site's origins in the Arkiv Hub.
VITE_ARKIV_ACCESS_KEY=
# Admin wallet that writes the curated token list
VITE_ARKIV_ADMIN_ADDRESS=

# Sepolia, ENSv2 broker names
VITE_SEPOLIA_RPC_URL=
VITE_ENS_PARENT_NAME=presettle.eth
