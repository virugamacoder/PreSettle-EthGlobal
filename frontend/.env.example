# ─────────────────────────────────────────────────────────────────────────────
# Pre Settle frontend: environment variables
#
# Local:      cp .env.example .env   (values below work for local development)
# Production: Vercel → Project → Settings → Environment Variables (one entry
#             per variable), then REDEPLOY: Vite builds these values into the site.
#
# Everything here is PUBLIC: it ends up in the browser bundle.
# Never put a private key or a server secret here.
# Lines marked "= backend X" must hold the same value as that variable in the
# backend's BACKEND_ENV_FILE. The Admin page's "Configuration check" compares them.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API, INCLUDING /v1
# Production: https://3.109.65.92.nip.io/v1
VITE_BASE_URL=http://localhost:3000/v1

# WalletConnect project ID from https://cloud.reown.com (add the site's domain
# there). Empty = browser wallets still work, mobile/QR wallets don't.
VITE_WALLETCONNECT_PROJECT_ID=

# ── Arc Testnet (chain 5042002) ──────────────────────────────────────────────
# Defaults to https://rpc.testnet.arc.io. If you use an Infura key here,
# restrict it to your site's domain in Infura (it is public).
VITE_ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
# Contract addresses from Arc Studio (0x + 40 hex). Empty until deployed.
# = backend OTC_CONTRACT
# Production: 0xB7c66d9136C5D6941467CC5B541b7272328DC17c
VITE_OTC_CONTRACT_ARC_TESTNET=
# = backend PREMARKET_CONTRACT
# Production: 0xB26990f986533AD138F70fc160a698Dd5E35Abf0
VITE_PREMARKET_CONTRACT_ARC_TESTNET=

# ── Arkiv Rabdi: the order book ──────────────────────────────────────────────
# Access key from https://hub.arkiv.network/access-keys. In Arkiv Hub add the
# site's origins (https://presettle-ethglobal.vercel.app, http://localhost:5173).
VITE_ARKIV_ACCESS_KEY=
# Wallet that publishes the curated token list (address only)
# = backend ARKIV_ADMIN_ADDRESS
VITE_ARKIV_ADMIN_ADDRESS=

# ── Sepolia: ENSv2 names ─────────────────────────────────────────────────────
# Sepolia RPC URL, e.g. https://ethereum-sepolia-rpc.publicnode.com
VITE_SEPOLIA_RPC_URL=
# = backend ENS_PARENT_NAME
VITE_ENS_PARENT_NAME=presettle.eth
