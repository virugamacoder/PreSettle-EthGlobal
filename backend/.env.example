# Copy to .env for local development.
# In production the whole file is stored in the BACKEND_ENV_FILE GitHub secret.
# Empty values are treated as "not set"; features that need them stay off.

NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
# Comma-separated list of allowed frontend origins (empty = allow all)
CORS_ORIGINS=http://localhost:5173

# ── Arc Testnet (chain 5042002) ─────────────────────────────────────────────
ARC_RPC_URL=https://rpc.testnet.arc.io
OTC_CONTRACT=
PREMARKET_CONTRACT=
BROKER_REGISTRY=

# ── Arkiv (order book) ──────────────────────────────────────────────────────
# Access key from https://hub.arkiv.network/access-keys (lock it to the server IP)
ARKIV_ACCESS_KEY=
# Wallet that writes the curated token list
ARKIV_ADMIN_ADDRESS=

# ── Sepolia ENSv2 (broker names) ────────────────────────────────────────────
SEPOLIA_RPC_URL=
ENS_PARENT_NAME=settlex.eth
ENS_USER_REGISTRY=

# ── Platform account: keeper + ENS admin (TESTNET-ONLY key) ─────────────────
PLATFORM_PRIVATE_KEY=
# Comma-separated admin wallet addresses
ADMIN_WALLETS=

# ── Keeper: automatic settlement after deadlines ────────────────────────────
KEEPER_ENABLED=false
KEEPER_INTERVAL_MS=30000

# ── Token prices ────────────────────────────────────────────────────────────
COINMARKETCAP_API_KEY=
