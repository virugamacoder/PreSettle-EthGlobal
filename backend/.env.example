# ─────────────────────────────────────────────────────────────────────────────
# Pre Settle backend: environment variables
#
# Local:      cp .env.example .env   (values below work for local development)
# Production: the WHOLE file (all lines) goes into ONE GitHub secret named
#             BACKEND_ENV_FILE. Do not create one secret per variable.
#             After changing it: Actions → Deploy Backend → Run workflow.
# Lines marked "= frontend X" must hold the same value as that Vercel variable.
# The Admin page's "Configuration check" compares them.
#
# Rules:
# - An empty value means "not set"; the feature that needs it stays off.
# - A malformed value (bad address, key without 0x, URL without https://)
#   stops the backend at startup with "Invalid environment configuration".
# - Never commit a real .env. Use TESTNET-ONLY private keys.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
# development | production | test
NODE_ENV=development
PORT=3000
# Public URL of this backend, without /v1 (used for uploaded image links)
# Production: https://3.109.65.92.nip.io
BASE_URL=http://localhost:3000
# Frontend origins allowed to call the API: comma-separated, with https://,
# NO trailing slash. Empty = allow every origin.
# Production: https://presettle-ethglobal.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ── Arc Testnet (chain 5042002): escrow contracts + USDC settlement ───────────
# Defaults to https://rpc.testnet.arc.io when empty. An Infura URL also works.
ARC_RPC_URL=https://rpc.testnet.arc.io
# Contract addresses from Arc Studio (0x + 40 hex). Empty until deployed:
# without OTC_CONTRACT, listings are shown unverified and the keeper is off.
# = frontend VITE_OTC_CONTRACT_ARC_TESTNET
OTC_CONTRACT=
# = frontend VITE_PREMARKET_CONTRACT_ARC_TESTNET
PREMARKET_CONTRACT=
# Optional broker contract (broker feature is paused): leave empty
BROKER_REGISTRY=

# ── Arkiv Rabdi: the order book ──────────────────────────────────────────────
# Access key from https://hub.arkiv.network/access-keys (raises rate limits).
# Production: add the server IP to the key's IP allowlist in Arkiv Hub.
ARKIV_ACCESS_KEY=
# Wallet that publishes the curated token list (address only, no key)
# = frontend VITE_ARKIV_ADMIN_ADDRESS
ARKIV_ADMIN_ADDRESS=

# ── Sepolia: ENSv2 names ─────────────────────────────────────────────────────
# Sepolia RPC URL, e.g. https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_RPC_URL=
# = frontend VITE_ENS_PARENT_NAME
ENS_PARENT_NAME=presettle.eth
# Subname registry from the ENS setup script. ENS features need it: empty = off
ENS_USER_REGISTRY=

# ── Admin login + platform wallet ────────────────────────────────────────────
# Admin wallet address(es), comma-separated. Addresses only: admins log in by
# signing with their own wallet. NEVER put an admin's private key anywhere here.
ADMIN_WALLETS=
# Signs admin session tokens. At least 32 characters: openssl rand -hex 32
AUTH_SECRET=
# Domain shown in the "Sign in with Ethereum" message: the frontend's domain
# ONLY, no https:// and no slash. Empty = domain not checked.
# Admin login then works only on that domain (not on localhost or Vercel
# preview URLs). Local development: leave it empty or use localhost:5173.
# Production: presettle-ethglobal.vercel.app
SIWE_DOMAIN=
# Private key (0x + 64 hex) of a separate TESTNET-ONLY "robot" wallet the
# server uses to send transactions on its own: keeper refunds on Arc
# (needs Arc Testnet USDC for gas) and ENS admin on Sepolia.
# Not the admin wallet. Empty = keeper and ENS admin off.
PLATFORM_PRIVATE_KEY=

# ── Keeper: refunds expired orders automatically ─────────────────────────────
# true needs PLATFORM_PRIVATE_KEY and OTC_CONTRACT
KEEPER_ENABLED=false
# How often it checks, in ms (minimum 5000)
KEEPER_INTERVAL_MS=30000

# ── Token prices ─────────────────────────────────────────────────────────────
# From https://pro.coinmarketcap.com. Empty = prices off
COINMARKETCAP_API_KEY=

# ── Storage ──────────────────────────────────────────────────────────────────
# Folder for view counts and uploaded images. In Docker this is forced to
# /app/data (a volume), so it can be left out of BACKEND_ENV_FILE.
DATA_DIR=./data
